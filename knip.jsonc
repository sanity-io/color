{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Spawned by oxlint's native binding for type-aware linting, which knip's
      // oxlint plugin doesn't detect yet
      "ignoreDependencies": ["tsrs"],
    },
    "apps/storybook": {},
    "packages/@sanity/color": {
      // The palette generator is invoked via the package's `generate` script,
      // not imported by application code
      "entry": ["scripts/generate.ts"],
    },
  },
}
